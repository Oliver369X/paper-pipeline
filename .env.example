# Copia este archivo a `.env` en esta carpeta y rellena los valores.
# NUNCA subas `.env` a git (ya está en .gitignore).
#
# Guía de flags 0/1 y prioridad mission.md vs .env: docs/VARIABLES_Y_FLAGS.md
#
# Variables marcadas (opcional) puedes omitirlas; el resto depende del flujo que uses.

# --- Cerebro (Gemini): chat que rellena misión + outputs/brain_brief.md (solo servidor) ---
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# Modelo cerebro (Gemini API). Por defecto: gemini-3.1-flash-lite-preview (doc Google AI).
# Alternativa Flash serie 3: gemini-3-flash-preview. No existe "gemini-3.1-flash" sin sufijo (API 404).
# BRAIN_MODEL=gemini-3.1-flash-lite-preview
# Límite de mensajes en el prompt del cerebro (recorte por cola; default 120 para hilos largos).
# BRAIN_MAX_HISTORY_MESSAGES=120
# Límite de caracteres del brief persistido inyectado en el prompt.
# BRAIN_MAX_BRIEF_CHARS=12000
# 1/true: antes del chat del cerebro, una pasada Perplexity (resumen web) si hay PERPLEXITY_SESSION_TOKEN.
# BRAIN_USE_PERPLEXITY_CONTEXT=
# 1/true (default): si el último mensaje cita arXiv (URL o id), forzar también resumen Perplexity aunque BRAIN_USE_PERPLEXITY_CONTEXT esté apagado (sigue requiriendo token).
# BRAIN_FORCE_PERPLEXITY_ON_ARXIV=1
# Tope de caracteres del extracto Perplexity inyectado.
# BRAIN_PERPLEXITY_CONTEXT_MAX_CHARS=8000
# Tope de caracteres de las últimas líneas de research_memory.jsonl inyectadas en el chat del cerebro (0 = desactivar).
# BRAIN_MAX_MEMORY_CONTEXT_CHARS=6000
# Si omitís run_pipeline en POST .../brain/apply, 1/true = ejecutar pipeline por defecto (compat: 0 = no ejecutar).
# BRAIN_DEFAULT_RUN_PIPELINE_ON_APPLY=0
# Tope de caracteres del bloque RAG semántico (0 = desactivar solo el bloque RAG; requiere BRAIN_RAG_ENABLED).
# BRAIN_MAX_RAG_CONTEXT_CHARS=4000

# --- RAG (embeddings Google + vector store; opcional) ---
# 1/true: inyectar recuperación semántica en el chat del cerebro e indexar tras pipeline / apply brief.
# BRAIN_RAG_ENABLED=0
# postgres (DATABASE_URL) | qdrant (QDRANT_URL). Requiere drivers: psycopg incluido; qdrant: pip install -e ".[rag_qdrant]"
# RAG_BACKEND=postgres
# Modelo embeddings: gemini-embedding-001 (API key) o text-embedding-004 en Vertex (ver RAG_EMBEDDING_USE_VERTEX).
# RAG_EMBEDDING_MODEL=gemini-embedding-001
# Dimensión del vector (debe coincidir con la columna en Postgres la primera vez; la tabla se crea sola).
# RAG_EMBEDDING_DIM=768
# 1/true: usar Vertex AI (GOOGLE_CLOUD_PROJECT + ADC o credenciales); si 0, usa GOOGLE_API_KEY como el cerebro.
# RAG_EMBEDDING_USE_VERTEX=0
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# Chunks y recuperación
# RAG_TOP_K=8
# RAG_CHUNK_MAX_CHARS=1800
# RAG_INGEST_MAX_FILE_BYTES=524288
# Postgres local o Docker (ver docker-compose.yml en esta carpeta):
# DATABASE_URL=postgresql://paper:paper@localhost:5433/paper_pipeline
# Qdrant (opcional; backend alternativo)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=paper_pipeline_rag

# --- Rigor científico / evaluación (sin vars obligatorias; ver docs/technical/EVALUATION_LAYERS.md) ---
# `enable_quality_check` en mission.md llama Perplexity sobre el borrador (revisión asistida, no validación empírica independiente).
# Tras un run con gates OK, el runner escribe outputs/evidence/claims_evidence_checklist.json (claims con evidence_status=unverified).

# --- Perplexity (pipeline principal, meta-loop, integración) ---
PERPLEXITY_SESSION_TOKEN=

# Solo algunos entornos (p. ej. MCP de Cursor); el cliente Python suele bastar con la cookie anterior.
# PERPLEXITY_CSRF_TOKEN=

# --- Notion: paper en misión (enable_notion + notion_page_id en mission.md) ---
# Misma integración interna que sueles usar con Notion MCP en el IDE.
# NOTION_TOKEN=

# --- Notion: triaje breakthrough (tier 3 del hipervisor; opcional) ---
# Página vacía en Notion, compartida con la integración; ID desde la URL.
# NOTION_TRIAGE_PAGE_ID=

# --- Notion: página solo para pytest smoke (opcional; ver docs/PRUEBAS_NIVELES_5_10_NOTION.md) ---
# Pegá la URL de la página o el UUID. La página debe tener «Conexiones» → tu integración añadida.
# NOTION_SMOKE_PAGE_ID=

# --- Webhook opcional: solo si quieres POST HTTPS en tier 3 (Slack/Discord/custom) ---
# PAPER_PIPELINE_TRIAGE_WEBHOOK_URL=

# --- Cursor CLI headless (opcional): https://cursor.com/docs/cli/headless ---
# CURSOR_API_KEY=
# Nombre en PATH o ruta absoluta al ejecutable (en Windows si falla el spawn, usá la ruta completa al agent.exe)
# CURSOR_AGENT_BIN=agent
# CURSOR_AGENT_EXTRA_ARGS=--model composer-2-fast
# RACING_LOOP_MAX=12
# CURSOR_CLI_TIMEOUT_SEC=1800
# Máximo de invocaciones del agent por run (reintentos con contexto si falla). Si está definido, pisa ``debugging.cursor_max_attempts`` en mission.md.
# CURSOR_CLI_MAX_ROUNDS=3
# Windows: si el prompt es largo, el runner envía el texto por stdin (evita «La línea de comandos es demasiado larga»).
# Forzar siempre stdin: CURSOR_CLI_PROMPT_STDIN=1 | desactivar: CURSOR_CLI_PROMPT_STDIN=0
# Umbral (solo Windows): por defecto 6000 caracteres antes de usar stdin.
# CURSOR_CLI_WIN_MAX_ARG_CHARS=6000
# Advertencia en run.log si `agent --version` no contiene esta cadena:
# CURSOR_AGENT_VERSION_EXPECTED=

# --- Interfaz web FastAPI: carpeta de misiones (por defecto ./data/missions desde el cwd del servidor) ---
# PAPER_PIPELINE_DATA_DIR=

# --- paper-parallel (batch worktree): prefijos permitidos para argv[0] (override en mission.md: parallel_allowed_command_prefixes) ---
# PAPER_PIPELINE_PARALLEL_CMD_PREFIXES=python,pytest,uv

# --- Experimentos: HF Hub + micro-LLM (``enable_experiment_runner`` + ``experiment_runner.profile: hf_llm_micro``; pip install -e ".[llm]") ---
# Token si el modelo/dataset es privado o para límites de descarga.
# HF_TOKEN=
# Caché de modelos/datasets (por defecto ~/.cache/huggingface).
# HF_HOME=
# El pipeline ejecuta ``outputs/code/run_experiment.py`` con este tope (segundos).
# PAPER_EXPERIMENT_TIMEOUT_SEC=7200

# --- Observabilidad / reanudación ---
# PAPER_PIPELINE_DISABLE_RUN_LOG=1
# PAPER_PIPELINE_DISABLE_RESUME=1

# --- Pipeline: honestidad ante fallos empíricos / resume (ver también mission.experiment_runner.block_pipeline_on_failure) ---
# 1/true: forzar que el run falle si metrics.json indica error del experiment runner (override a “bloquear”).
# PAPER_PIPELINE_STRICT_EXPERIMENT=1
# 0/false: no bloquear por experimento aunque la misión tenga block_pipeline_on_failure (solo narrativo).
# PAPER_PIPELINE_STRICT_EXPERIMENT=0
# 1/true: tras fallo crítico, borrar también pasos perplexity:* de run_state (regenera secciones; más cuota Perplexity).
# PAPER_PIPELINE_INVALIDATE_PERPLEXITY_ON_EXP_FAIL=1
# Fallback HF: si ``experiment_runner.profile`` es hf_llm_micro/auto y faltan torch/transformers, el servidor
# puede ejecutar el benchmark numpy sintético (default en mission: ``fallback_minimal_on_hf_import_error: true``).
# Para réplica HF real: pip install paper-pipeline[llm]
# Cursor CLI: 1/true = un fallo del agente no aborta el run (equivale a mission.cursor_cli_optional; default en misión es true).
# PAPER_PIPELINE_CURSOR_CLI_OPTIONAL=1

# --- paper-loop: borrador sin cambios entre ciclos (salida 8 = LOOP_STALLED) ---
# LOOP_STALL_DETECT=1
# Umbral de ciclos seguidos sin progreso (alias legacy: LOOP_STALL_CONSECUTIVE)
# LOOP_STALL_MAX_CONSECUTIVE=2
# LOOP_STALL_CONSECUTIVE=2
# Tamaño mínimo de cambio de caracteres para no considerar estancamiento (loop_stall_detector)
# LOOP_MIN_DELTA_CHARS=20
# Generar research_pack/ + code_pack/MANIFEST.md al escribir publish (requiere elegible + flag)
# PAPER_PIPELINE_BUILD_PACKS=1

# --- Perplexity Strategy Layer V1: registrar perfiles en outputs/perplexity_call_record.jsonl (antes de cada ask) ---
# PAPER_PIPELINE_PERPLEXITY_STRATEGY=1

# --- Modo autonomía (scheduler): permite que `would_execute` sea true en `agent_decisions.jsonl` cuando dry_run=false,
#     mission.mode=autonomy y gates OK. La invocación real del pipeline sigue siendo no-op hasta cablear explícitamente.
# PAPER_PIPELINE_AUTONOMY_EXECUTE=1

# --- Hipervisor triage: si MetricsBundle falla pero el JSON aún es parseable como TriageMetrics (legacy) ---
# PAPER_PIPELINE_RELAX_METRICS=1

# --- Meta-loop / paper-meta-loop ---
# META_MAX_ROUNDS=12

# --- paper-meta-watch ---
# META_WATCH_POLL=2
# META_WATCH_DEBOUNCE=1.5
# META_WATCH_EXIT_ON_STOP=1
